<?xml version="1.0" encoding="utf-8"?>
<contentList>
	<content contentuid="NRT_katon_goukakyu_DisplayName">火遁·豪火球之术</content>
	<content contentuid="NRT_katon_goukakyu_Description">从口中喷出巨大的火球，撞击后爆炸，灼烧范围内的一切。</content>
	<content contentuid="NRT_katon_housenka_DisplayName">凤仙火</content>
	<content contentuid="NRT_katon_housenka_Description">从口中喷出如凤仙花般散开的数团火焰，覆盖面前的扇形区域。</content>
	<content contentuid="NRT_katon_amaterasu_DisplayName">天照</content>
	<content contentuid="NRT_katon_amaterasu_Description">黑色的不灭之炎，燃尽一切。目标区域燃起诅咒之火，黑炎持续吞噬敌人，直到其灰飞烟灭。</content>
	<content contentuid="NRT_suiton_suiryudan_DisplayName">水遁·水龙弹之术</content>
	<content contentuid="NRT_suiton_suiryudan_Description">以查克拉凝成水龙，冲击目标并使其湿透。</content>
	<content contentuid="NRT_suiton_suijinha_DisplayName">水铁炮</content>
	<content contentuid="NRT_suiton_suijinha_Description">以指尖弹射高压水弹，冲击并击湿目标，浇灭火焰。</content>
	<content contentuid="NRT_suiton_kirigakure_DisplayName">雾隐之术</content>
	<content contentuid="NRT_suiton_kirigakure_Description">制造浓雾遮蔽视线，使敌人陷入失明。</content>
	<content contentuid="NRT_raiton_raikiri_DisplayName">雷遁·雷切</content>
	<content contentuid="NRT_raiton_raikiri_Description">将雷属性查克拉集中于手，以迅雷之势突进贯穿目标。</content>
	<content contentuid="NRT_raiton_chidori_DisplayName">千鸟</content>
	<content contentuid="NRT_raiton_chidori_Description">将雷遁查克拉凝聚于手，如千鸟齐鸣般疾冲突进，贯穿目标。雷切的雏形，更快更轻。</content>
	<content contentuid="NRT_raiton_kirin_DisplayName">麒麟</content>
	<content contentuid="NRT_raiton_kirin_Description">引动天雷凝聚成麒麟之姿轰然降下，在大范围内释放毁灭性的雷电。</content>
	<content contentuid="NRT_fuuton_daihakki_DisplayName">风遁·大突破</content>
	<content contentuid="NRT_fuuton_daihakki_Description">深吸一口气喷出狂风，击退面前的敌人。</content>
	<content contentuid="NRT_fuuton_rasengan_DisplayName">螺旋丸</content>
	<content contentuid="NRT_fuuton_rasengan_Description">将旋转的查克拉凝聚于掌心的球形气弹，近身轰击目标并击飞。</content>
	<content contentuid="NRT_fuuton_rasenshuriken_DisplayName">螺旋手里剑</content>
	<content contentuid="NRT_fuuton_rasenshuriken_Description">将螺旋丸化为巨型旋转手里剑掷出，命中后爆开，绞杀大片敌人。</content>
	<content contentuid="NRT_doton_doryusou_DisplayName">土遁·土隆枪</content>
	<content contentuid="NRT_doton_doryusou_Description">令大地隆起尖锐的石枪，从脚下贯穿目标。</content>
	<content contentuid="NRT_doton_sabaku_DisplayName">砂暴</content>
	<content contentuid="NRT_doton_sabaku_Description">卷起漫天砂尘笼罩区域，将地面化为流沙，令敌人寸步难行。</content>
	<content contentuid="NRT_doujutsu_sharingan_DisplayName">写轮眼</content>
	<content contentuid="NRT_doujutsu_sharingan_Description">瞳力全开，预判敌人的一切动作，提升暴击与闪避。</content>
	<content contentuid="NRT_doujutsu_mangekyo_DisplayName">万花筒写轮眼</content>
	<content contentuid="NRT_doujutsu_mangekyo_Description">更高层次的瞳力，眼中的世界已然不同，大幅提升暴击与闪避。</content>
	<content contentuid="NRT_doujutsu_tsukuyomi_DisplayName">月读</content>
	<content contentuid="NRT_doujutsu_tsukuyomi_Description">将敌人拉入幻术世界，在精神世界中将其囚禁，现实中则冻结其身心。</content>
	<content contentuid="NRT_doujutsu_kamui_DisplayName">神威</content>
	<content contentuid="NRT_doujutsu_kamui_Description">扭曲空间，将目标卷入异空间后从高空掷落，坠落造成重创。</content>
	<content contentuid="NRT_doujutsu_koto_DisplayName">别天神</content>
	<content contentuid="NRT_doujutsu_koto_Description">以无声的瞳力支配敌人的精神，将敌人化为己方战力。</content>
	<content contentuid="NRT_doujutsu_susanoo_DisplayName">须佐能乎</content>
	<content contentuid="NRT_doujutsu_susanoo_Description">召唤巨大的查克拉化身，庇护自身并碾压敌人。</content>
	<content contentuid="NRT_kunai_DisplayName">手里剑</content>
	<content contentuid="NRT_kunai_Description">掷出手里剑，以极快的速度精准攻击单个目标。</content>
	<content contentuid="NRT_shunshin_DisplayName">瞬身术</content>
	<content contentuid="NRT_shunshin_Description">以惊人速度瞬间移动至目标位置，用于位移与突袭。</content>
	<content contentuid="NRT_SHARINGAN_DisplayName">写轮眼</content>
	<content contentuid="NRT_SHARINGAN_Description">预判敌人的动作：暴击 +5%，闪避 +5%。</content>
	<content contentuid="NRT_MANGEKYO_DisplayName">万花筒写轮眼</content>
	<content contentuid="NRT_MANGEKYO_Description">更深的瞳力：暴击 +10%，闪避 +10%。</content>
	<content contentuid="NRT_AMATERASU_DisplayName">天照</content>
	<content contentuid="NRT_AMATERASU_Description">黑色不灭之炎缠绕周身，每回合吞噬生命。</content>
</contentList>
