			<node id="TranslatedStringKey">
				<attribute id="Content" type="28" handle="hec714df7gcb73g3b08g9895g6e7c5ba1fc61" value="引动天雷凝聚成麒麟之姿轰然降下，在大范围内释放毁灭性的雷电。" />
